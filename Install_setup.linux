#!/bin/bash
set -euo pipefail

# Do not run this script with sudo
if [ "$EUID" -eq 0 ]; then
    echo "Run as your normal user; sudo is asked for only where needed."
    exit 1
fi

hostID=$(hostname)
if ! grep -qw "$hostID" /etc/hosts; then
    echo "127.0.1.1 $hostID" | sudo tee -a /etc/hosts > /dev/null
fi
if ! grep -q "^127.0.0.1[[:space:]]\+localhost" /etc/hosts; then
    echo "127.0.0.1 localhost" | sudo tee -a /etc/hosts > /dev/null
fi

BIO_DIR="$HOME/Bioinformatics"
mkdir -p "$BIO_DIR/Scripts"

sudo apt update
sudo apt install -y unzip default-jre-headless

if ! grep -q "$BIO_DIR" "$HOME/.bashrc"; then
    echo "export PATH=\$PATH:$BIO_DIR" >> "$HOME/.bashrc"
    echo "export PATH=\$PATH:$BIO_DIR/Scripts" >> "$HOME/.bashrc"
fi

# conda is usually not on PATH in non-interactive shells, load it explicitly
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    source "$HOME/miniconda3/etc/profile.d/conda.sh"
elif command -v conda >/dev/null 2>&1; then
    eval "$(conda shell.bash hook)"
else
    echo "Conda was not found. Install Miniconda first, then rerun." >&2
    exit 1
fi

# accept Anaconda channel Terms of Service (one-off, harmless to repeat)
conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# dedicated env: fast solve, does not touch base
conda create -y -n bioinf --override-channels -c conda-forge -c bioconda --strict-channel-priority \
    python=3.11 \
    blast fastqc clustalo raxml cd-hit diamond samtools abricate \
    bbmap shovill quast dfast seqkit snp-sites fasttree figtree gdown
conda activate bioinf
abricate --setupdb --quiet

# download shared folder (scripts/databases) from Google Drive
cd "$BIO_DIR"
gdown --folder 13iPSVLzRlJ7e5Ag1xnP-rfEpzjXvVxFu

cd MICR3330_Bioinformatics
unzip Contigs_dir.zip
unzip References_dir.zip
unzip fastq_dir.zip
rm *.zip
cd ../Scripts
wget -q "https://raw.githubusercontent.com/alfred-tay/MICR3330/refs/heads/main/23s_resistance.linux" \
     "https://raw.githubusercontent.com/alfred-tay/MICR3330/refs/heads/main/GyrA_resistance.linux" \
     "https://raw.githubusercontent.com/alfred-tay/MICR3330/refs/heads/main/Gene_extraction_part1.linux" \
     "https://raw.githubusercontent.com/alfred-tay/MICR3330/refs/heads/main/Gene_extraction_part2.linux" \
     "https://raw.githubusercontent.com/alfred-tay/MICR3330/refs/heads/main/MLST_ref"
chmod +x *.linux
cd ..

echo
echo "Done. Open a new terminal (or run: source ~/.bashrc), then: conda activate bioinf"
